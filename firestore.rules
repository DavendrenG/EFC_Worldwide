rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// DEMO MODE
//
// Any signed-in account can write. Acceptable while the database holds only
// seed content and nobody outside Geoserve has the project id.
//
// BEFORE REAL EFC CONTENT OR FAN DATA GOES IN, restore the staff check:
//
//   function isStaff() {
//     return request.auth != null && request.auth.token.efcStaff == true;
//   }
//
// and grant the claim per account with the Admin SDK:
//   await getAuth().setCustomUserClaims(uid, { efcStaff: true });
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Published content — the app reads anonymously, staff write.
    match /events/{id}   { allow read: if true; allow write: if isSignedIn(); }
    match /fighters/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /videos/{id}   { allow read: if true; allow write: if isSignedIn(); }
    match /results/{id}  { allow read: if true; allow write: if isSignedIn(); }

    // Drafts stay invisible to the app until published is true.
    match /articles/{id} {
      allow read: if resource.data.published == true || isSignedIn();
      allow write: if isSignedIn();
    }

    // Push triggers. The app never reads these — only the Cloud Function does,
    // and Admin SDK access bypasses rules entirely.
    match /alerts/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Device tokens: the app writes its own, nothing reads them back client-side.
    match /devices/{token} {
      allow read: if false;
      allow write: if true;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
